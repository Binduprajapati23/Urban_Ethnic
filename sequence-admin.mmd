sequenceDiagram
    autonumber
    actor AdminUser as Admin
    participant UI as Admin Frontend
    participant Guard as AdminRoute
    participant LS as localStorage

    AdminUser->>UI: Login with admin credentials
    UI->>LS: Save session with role=admin

    AdminUser->>UI: Open /admin
    UI->>Guard: Check access
    Guard->>LS: Read current user
    LS-->>Guard: User role admin
    Guard-->>UI: Access granted

    UI->>LS: Read admin_orders
    UI->>LS: Read admin_rentals
    UI->>LS: Read admin_products
    LS-->>UI: Current datasets
    UI-->>AdminUser: Show live dashboard metrics

    AdminUser->>UI: Update order status
    UI->>LS: Save admin_orders
    LS-->>UI: Updated list
    UI-->>AdminUser: Orders UI refreshed

    AdminUser->>UI: Update rental status
    UI->>LS: Save admin_rentals
    LS-->>UI: Updated list
    UI-->>AdminUser: Rentals UI refreshed

    AdminUser->>UI: Add edit delete product
    UI->>LS: Save admin_products
    LS-->>UI: Updated catalog
    UI-->>AdminUser: Product inventory refreshed

    AdminUser->>UI: Open dashboard again
    UI->>LS: Reload admin data keys
    LS-->>UI: Latest values
    UI-->>AdminUser: Updated cards and recent data
